# CAT Legacy Environment Configuration
# Copy this file to .env before starting: cp .env.example .env

# Server & Network Ports
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Frontend API Connection (Configurable for local vs production hosts)
VITE_API_BASE_URL=http://localhost:8000

# Database Configuration (SQLite default for zero-config; supports postgresql://user:pass@host:5432/cat_legacy)
DATABASE_URL=sqlite:///./cat_legacy.db

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Deterministic Simulation & Demo Settings
SEED=42
DEMO_STREAMING_SPEED=1.0
ENVIRONMENT=development
